<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            Las pruebas corren sobre PostgreSQL, el mismo motor que produccion.

            Estaban sobre SQLite en memoria, que arranca mas rapido pero no
            entiende GREATEST, FILTER (WHERE ...) ni ILIKE, que es SQL que el
            codigo usa de verdad. El resultado era que cinco pruebas del
            checkout llevaban rotas desde que se introdujo el inventario por
            lotes, y la suite no podia detectarlo porque fallaba antes, en el
            propio motor.

            La base botica_san_juan_test se crea una vez:
                createdb botica_san_juan_test
            El resto de la conexion (host, usuario, contrasena) sale del .env.
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="botica_san_juan_test"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
