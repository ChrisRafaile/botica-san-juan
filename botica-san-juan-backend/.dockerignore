# Lo que NO debe entrar en la imagen.
# El motivo no es solo el tamano: .env lleva credenciales reales y meterlo en
# una capa de Docker las deja ahi para siempre, aunque despues se borre el
# archivo en una capa posterior.
.env
.env.*
!.env.example

.git
.gitignore
.github

vendor/
node_modules/

storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/app/public/*

# El enlace public/storage lo crea el entrypoint en cada arranque. Si entrara
# en la imagen seria un enlace creado en OTRA maquina, apuntando a una ruta
# que dentro del contenedor puede no existir: un enlace roto que `storage:link`
# no podria rehacer sin --force y que servia 404 sin explicar por que.
public/storage

tests/
phpunit.xml
.phpunit.result.cache

# Volcados de base de datos: nunca en la imagen.
*.dump
*.sql
infra/backup/salida/

README.md
*.md
