APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

CORS_ALLOWED_ORIGINS=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_AUDIT_LEVEL=info
LOG_AUDIT_DAYS=30

# ---------------------------------------------------------------------------
# Base de datos - PostgreSQL 16
# ---------------------------------------------------------------------------
# Crear la base antes del primer despliegue:
#   CREATE DATABASE botica_san_juan ENCODING 'UTF8';
# Luego ejecutar:  php artisan migrate --force
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=botica_san_juan
DB_USERNAME=postgres
DB_PASSWORD=
DB_CHARSET=utf8
DB_SSLMODE=prefer

# Solo para pruebas automatizadas (phpunit usa una base en memoria)
# DB_CONNECTION=sqlite
# DB_DATABASE=:memory:

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

COMPANY_RUC=20123456789
COMPANY_RAZON_SOCIAL="Botica San Juan SAC"
COMPANY_DIRECCION="Av. Principal 123 - Lima"
COMPANY_TELEFONO=
COMPANY_EMAIL=
COMPANY_LOGO_PATH="images/logo.png"

# --- Izipay (pasarela de pagos) -------------------------------------------
# 'simulado' permite probar el flujo completo sin credenciales; 'api' invoca
# al proveedor real. Las claves privadas NUNCA se exponen al frontend.
IZIPAY_MODE=simulado
IZIPAY_BASE_URL=https://api.micuentaweb.pe
# Cliente JavaScript y tema del formulario embebido (recursos publicos).
IZIPAY_CLIENT_URL=https://static.micuentaweb.pe
IZIPAY_CLIENT_THEME=neon
# --- Credenciales. NO se versionan. Se copian del panel del comercio. ---
# Usuario (identificador de tienda) y contrasena: autenticacion basica de la API
# y, ademas, la contrasena firma la notificacion servidor a servidor.
IZIPAY_USERNAME=
IZIPAY_PASSWORD=
# Llave publica: viaja al navegador. Es la unica que puede hacerlo.
IZIPAY_PUBLIC_KEY=
# Clave HMAC-SHA-256: firma el retorno del navegador. Distinta de la contrasena.
IZIPAY_SHA256_KEY=
# Segmento secreto de la ruta de notificacion. Genera uno propio y largo.
IZIPAY_WEBHOOK_PATH=cambia-este-segmento-secreto
# URL completa de notificacion, con el segmento secreto incluido. Debe ser
# alcanzable desde internet para que la pasarela pueda invocarla.
IZIPAY_IPN_URL=
IZIPAY_CURRENCY=PEN
IZIPAY_TIMEOUT=20
