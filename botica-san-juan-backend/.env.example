# Aparece en el encabezado de los correos transaccionales. Mientras valga
# "Laravel", la plantilla de Laravel inserta ademas su propio logotipo.
APP_NAME="Botica San Juan"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Las plantillas de correo de Laravel traen frases propias que se traducen por
# el idioma de la aplicacion, no por lo que escriba la notificacion.
APP_LOCALE=es
# El idioma de reserva se queda en `en` a proposito. Con `es` en los dos, una
# clave que falte en lang/es/ sale en crudo —«validation.required»— y eso se
# ve literalmente en pantalla.
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_AUDIT_LEVEL=info
LOG_AUDIT_DAYS=30

# ---------------------------------------------------------------------------
# Base de datos - PostgreSQL 16
# ---------------------------------------------------------------------------
# Crear la base antes del primer despliegue:
#   CREATE DATABASE botica_san_juan ENCODING 'UTF8';
# Luego ejecutar:  php artisan migrate --force
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=botica_san_juan
DB_USERNAME=postgres
DB_PASSWORD=
DB_CHARSET=utf8
DB_SSLMODE=prefer

# Solo para pruebas automatizadas (phpunit usa una base en memoria)
# DB_CONNECTION=sqlite
# DB_DATABASE=:memory:

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo transaccional.
#
# En local y en pruebas conviene dejar `log`: los correos quedan escritos en
# storage/logs/laravel.log y no se gasta cuota ni se molesta a nadie.
# Para enviar de verdad: MAIL_MAILER=resend y una clave de envio.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Mientras no haya dominio verificado, Resend solo acepta este remitente y solo
# entrega al correo de la cuenta. Con dominio propio: no-responder@tu-dominio.
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="Botica San Juan"

# Clave de envio de Resend. Se deja VACIA en el ejemplo a proposito.
RESEND_API_KEY=

# El paquete registra por su cuenta un POST /resend/webhook, y su controlador
# SOLO comprueba la firma si existe RESEND_WEBHOOK_SECRET. Sin secreto eso es
# un punto de entrada publico que acepta eventos inventados: se desactiva.
# Para activarlo hay que definir ANTES el secreto del webhook.
RESEND_ROUTES=false

# Base del portal para los enlaces de los correos. Apunta al frontend, no a la
# API: quien recibe el correo abre el enlace en su navegador.
FRONTEND_URL=http://localhost:5173

# Acceso con Google (OAuth 2.0). Credenciales del cliente web creado en
# Google Cloud Console. El secreto se deja VACIO en el ejemplo a proposito.
#
# GOOGLE_REDIRECT_URI tiene que coincidir CARACTER A CARACTER con uno de los
# «URI de redireccionamiento autorizados» del cliente. Apunta a la API, no al
# portal. Ver docs/GOOGLE-OAUTH.md.
#
#   Local ......... http://127.0.0.1:8083/api/auth/google/callback
#   Produccion .... https://botica-san-juan-api.onrender.com/api/auth/google/callback
#
# Sin GOOGLE_CLIENT_ID el boton de Google no se muestra en el portal: mas vale
# que no aparezca a que aparezca y falle.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8083/api/auth/google/callback

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Datos del emisor -----------------------------------------------------
# Los valores de abajo son MARCADORES. Los reales se ponen en el .env de cada
# maquina y no se versionan.
#
# Esto no es celo de mas: el RUC de la botica es de persona natural, y ese
# tipo de RUC lleva el DNI del titular dentro del propio numero. Escribirlo
# aqui publicaria el documento de identidad y el nombre completo de una
# persona real en un repositorio publico, y ademas quedaria en el historial
# de git aunque despues se borrara del archivo.
COMPANY_RUC=20123456789
COMPANY_RAZON_SOCIAL="Botica San Juan SAC"
COMPANY_DIRECCION="Av. Principal 123 - Lima"
COMPANY_TELEFONO=
COMPANY_EMAIL=
COMPANY_LOGO_PATH="images/logo.png"

# --- SUNAT (facturacion electronica) --------------------------------------
# 'simulado' recorre las mismas capas que el envio real -ZIP, Base64, sobre
# SOAP y lectura del CDR- sin salir del proceso. 'api' manda de verdad.
SUNAT_MODE=simulado
SUNAT_TIMEOUT=20
# Endpoint. Por omision apunta al entorno beta, donde se puede validar el
# empaquetado aunque la firma todavia no sea definitiva.
SUNAT_ENDPOINT=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
# --- Credenciales. NO se versionan. ---
# El usuario tiene que ser SECUNDARIO: con el principal el servicio rechaza
# la peticion por politica, y el mensaje de error no lo explica.
SUNAT_SOL_USUARIO=
SUNAT_SOL_CLAVE=

# --- Izipay (pasarela de pagos) -------------------------------------------
# 'simulado' permite probar el flujo completo sin credenciales; 'api' invoca
# al proveedor real. Las claves privadas NUNCA se exponen al frontend.
IZIPAY_MODE=simulado
IZIPAY_BASE_URL=https://api.micuentaweb.pe
# Cliente JavaScript y tema del formulario embebido (recursos publicos).
IZIPAY_CLIENT_URL=https://static.micuentaweb.pe
IZIPAY_CLIENT_THEME=neon
# --- Credenciales. NO se versionan. Se copian del panel del comercio. ---
# Usuario (identificador de tienda) y contrasena: autenticacion basica de la API
# y, ademas, la contrasena firma la notificacion servidor a servidor.
IZIPAY_USERNAME=
IZIPAY_PASSWORD=
# Llave publica: viaja al navegador. Es la unica que puede hacerlo.
IZIPAY_PUBLIC_KEY=
# Clave HMAC-SHA-256: firma el retorno del navegador. Distinta de la contrasena.
IZIPAY_SHA256_KEY=
# Segmento secreto de la ruta de notificacion. Genera uno propio y largo.
IZIPAY_WEBHOOK_PATH=cambia-este-segmento-secreto
# URL completa de notificacion, con el segmento secreto incluido. Debe ser
# alcanzable desde internet para que la pasarela pueda invocarla.
IZIPAY_IPN_URL=
IZIPAY_CURRENCY=PEN
IZIPAY_TIMEOUT=20

# --- Monitoreo de errores · Sentry ----------------------------------------
# SE QUEDA VACIO A PROPOSITO. Sin DSN el SDK no envia nada: ese es el estado
# por omision y el de desarrollo. Activarlo es una decision por entorno.
#
# Lo que sale va depurado: ver config/sentry.php y
# app/Support/Observabilidad/Depurador.php, y los criterios en
# docs/OBSERVABILIDAD.md. Nunca poner send_default_pii en true.
SENTRY_LARAVEL_DSN=
# Version desplegada, para agrupar los errores por despliegue.
SENTRY_RELEASE=
# Muestreo de trazas de rendimiento. 0.0 = apagado, que es lo que corresponde
# mientras nadie las mire: llevan rutas con identificadores dentro.
SENTRY_TRACES_SAMPLE_RATE=0.0
