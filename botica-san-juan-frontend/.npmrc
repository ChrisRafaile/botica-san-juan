# Configuración de pnpm · Botica San Juan (frontend)

# Instala automáticamente las peer dependencies que declaren los paquetes.
auto-install-peers=true

# No aborta la instalación por conflictos de peers entre librerías de terceros.
strict-peer-dependencies=false

# Falla pronto si la versión de Node no cumple el campo "engines" del
# package.json, en vez de reventar más tarde durante el build.
engine-strict=true

# Eleva a la raíz de node_modules los paquetes que ESLint y TypeScript esperan
# encontrar de forma plana. El aislamiento estricto de pnpm los dejaría fuera
# del árbol visible y romperían el linting y la resolución de tipos.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=@types/*
