# ---------------------------------------------------------------------------
# Configuracion del Front-End - Sistema Web de Gestion Botica San Juan
# ---------------------------------------------------------------------------
# Copiar este archivo como .env y ajustar los valores segun el entorno.
# Vite solo expone al navegador las variables que empiezan con VITE_.

# URL base de la API REST.
#   Desarrollo local .......... http://127.0.0.1:8083/api
#   Aplicacion de escritorio .. http://127.0.0.1:8083/api
#   Produccion ................ https://api.boticasanjuan.pe/api
VITE_API_URL=http://127.0.0.1:8083/api

# Tiempo maximo de espera de una peticion, en milisegundos.
VITE_API_TIMEOUT=20000

# Nombre visible de la aplicacion.
VITE_APP_NAME="Botica San Juan"
